msgid "📸 Send a photo or choose from the menu"
msgstr "📸 Отправь фото или выбери действие в меню"

#: app/text.py:462
msgid "❌ You need at least 1 photo to create your profile!"
msgstr "❌ Для создания анкеты нужно хотя бы одно фото!"

#: app/text.py:466
#, python-brace-format
msgid ""
"\n"
"🎂 <b>Set Your Age Range</b>\n"
"\n"
"Current range: <b>{min_age} - {max_age} years old</b>\n"
"\n"
"Enter the <b>minimum age</b> you want to see (18-99):\n"
"\n"
"Type a number or press ↩️ to cancel.\n"
msgstr ""
"\n"
"🎂 <b>Настройка возраста</b>\n"
"\n"
"Текущий диапазон: <b>{min_age} - {max_age} лет</b>\n"
"\n"
"Введи <b>минимальный возраст</b> (18-99):\n"
"\n"
"Напиши число или нажми ↩️ для отмены.\n"

#: app/text.py:477
#, python-brace-format
msgid ""
"\n"
"🎂 <b>Set Your Age Range</b>\n"
"\n"
"Minimum age: <b>{min_age}</b> ✅\n"
"\n"
"Now enter the <b>maximum age</b> (18-99):\n"
"\n"
"Type a number or press ↩️ to cancel.\n"
msgstr ""
"\n"
"🎂 <b>Настройка возраста</b>\n"
"\n"
"Минимальный возраст: <b>{min_age}</b> ✅\n"
"\n"
"Теперь введи <b>максимальный возраст</b> (18-99):\n"
"\n"
"Напиши число или нажми ↩️ для отмены.\n"

#: app/text.py:488
#, python-brace-format
msgid ""
"\n"
"✅ <b>Age filter set!</b>\n"
"\n"
"You'll now see profiles from <b>{min_age} to {max_age} years old</b>.\n"
"\n"
"Hit 🔍 to start browsing with your new filter!\n"
msgstr ""
"\n"
"✅ <b>Фильтр возраста установлен!</b>\n"
"\n"
"Теперь ты будешь видеть анкеты от <b>{min_age} до {max_age} лет</b>.\n"
"\n"
"Нажми 🔍 чтобы начать поиск с новым фильтром!\n"

#: app/text.py:498
msgid ""
"\n"
"🔄 <b>Age filter reset!</b>\n"
"\n"
"Back to automatic age matching based on your age and compatibility.\n"
"\n"
"Hit 🔍 to start browsing!\n"
msgstr ""
"\n"
"🔄 <b>Фильтр возраста сброшен!</b>\n"
"\n"
"Возврат к автоматическому подбору по возрасту и совместимости.\n"
"\n"
"Нажми 🔍 для поиска!\n"

#: app/text.py:508
msgid "❌ Age filter setup cancelled."
msgstr "❌ Настройка фильтра возраста отменена."

#: app/text.py:512
msgid "⚠️ Age must be at least 18. Try again!"
msgstr "⚠️ Возраст должен быть не менее 18 лет! Попробуй снова."

#: app/text.py:516
msgid "⚠️ Age must be between 18 and 99. Try again!"
msgstr "⚠️ Возраст должен быть от 18 до 99 лет! Попробуй снова."

#: app/text.py:519
#, python-brace-format
msgid ""
"\n"
"⚠️ Max age must be ≥ min age (<b>{min_age}</b>).\n"
"\n"
"Enter a valid maximum age:\n"
msgstr ""
"\n"
"⚠️ Максимальный возраст должен быть ≥ минимального (<b>{min_age}</b>).\n"
"\n"
"Введи корректный максимальный возраст:\n"

#: app/text.py:527
msgid "⚠️ Numbers only! Enter an age between 18-99."
msgstr "⚠️ Только числа! Введи возраст от 18 до 99."

