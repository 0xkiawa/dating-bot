#: app/text.py:277
msgid ""
"🤝 <b>No more profiles in Friends mode!</b>\n"
"\n"
"Tweak your filters or check back later to grow your tribe! 🌈"
msgstr ""
"🤝 <b>¡No hay más perfiles en modo Friends!</b>\n"
