msgid "✅ Done, save photos"
msgstr "✅ Готово, сохранить фото"

#: app/text.py:436
#, python-brace-format
msgid ""
"📸 Photo {current}/{total} uploaded!\n"
"\n"
"You can add {remaining} more or tap '{finish_button}'"
msgstr ""
"📸 Фото {current}/{total} загружено!\n"
"\n"
"Можно добавить ещё {remaining} или нажать '{finish_button}'"

#: app/text.py:447
#, python-brace-format
