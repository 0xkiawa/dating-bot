#: app/text.py:242
msgid ""
"👑 <b>Profile created!</b>\n"
"\n"
"You're all set! Time to start conquering. Hit 🎭 to choose your mode!"
msgstr ""
"👑 <b>¡Perfil creado!</b>\n"
"\n"
"¡Todo listo! Es hora de empezar a conquistar. ¡Toca 🎭 para elegir tu modo!"

#: app/text.py:246
msgid ""
"\n"
"❌ <b>Profile disabled</b>\n"
"\n"
"Your profile is now hidden and some features are unavailable.\n"
"\n"
"Want to come back? Just send /start to reactivate!\n"
msgstr ""
"\n"
"❌ <b>Perfil desactivado</b>\n"
"\n"
"Tu perfil ahora está oculto y algunas funciones no están disponibles.\n"
"\n"
"¿Quieres volver? ¡Solo envía /start para reactivarlo!\n"

#: app/text.py:256
msgid ""
"✅ <b>Welcome back, king!</b>\n"
"\n"
"Your profile is active again. Let's conquer! 👑"
msgstr ""
"✅ <b>¡Bienvenido de vuelta, rey!</b>\n"
"\n"
"Tu perfil está activo de nuevo. ¡A conquistar! 👑"

#: app/text.py:260
msgid "🔍 <b>Searching for matches...</b>"
msgstr "🔍 <b>Buscando perfiles...</b>"

#: app/text.py:264
#, python-brace-format
msgid ""
"📬 <b>{} guys liked your profile!</b>\n"
"\n"
"Let's see who they are:"
