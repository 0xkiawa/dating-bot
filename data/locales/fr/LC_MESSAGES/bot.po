msgstr ""
"Aucun profil trouvé dans ce mode. Ajuste tes filtres ou reviens plus tard"
" ! 🌍"

#: app/text.py:273
msgid ""
"🍆 <b>No more profiles in Fun mode!</b>\n"
"\n"
"Try changing your age/hosting filters or check back later for fresh meat!"
" 🔥"
msgstr ""
"🍆 <b>Plus de profils en mode Fun !</b>\n"
"\n"
"Modifie tes filtres d'âge/hébergement ou reviens plus tard ! 🔥"

#: app/text.py:275
msgid ""
"❤️ <b>No more profiles in Dating mode!</b>\n"
"\n"
"Adjust your filters or come back soon — your match might be just around "
"the corner! 💕"
msgstr ""
"❤️ <b>Plus de profils en mode Dating !</b>\n"
"\n"
"Ajuste tes filtres ou reviens bientôt — ton crush est peut-être tout près"
" ! 💕"

#: app/text.py:277
msgid ""
"🤝 <b>No more profiles in Friends mode!</b>\n"
"\n"
"Tweak your filters or check back later to grow your tribe! 🌈"
msgstr ""
"🤝 <b>Plus de profils en mode Friends !</b>\n"
"\n"
"Ajuste tes filtres ou reviens plus tard pour élargir ta tribu ! 🌈"

#: app/text.py:278
msgid ""
"😔 <b>No more profiles right now!</b>\n"
"\n"
"Adjust your filters (age/hosting) or try again later!"
msgstr ""
"😔 <b>Plus de profils pour le moment !</b>\n"
"\n"
"Ajuste tes filtres (âge/hébergement) ou réessaie plus tard !"

#: app/text.py:282
#, python-brace-format
