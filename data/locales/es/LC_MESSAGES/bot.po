#: app/text.py:427
msgid "❌ Error saving photos. Please try again."
msgstr "❌ Error al guardar las fotos. Inténtalo de nuevo."

#: app/text.py:431 app/text.py:441
msgid "✅ Done, save photos"
msgstr "✅ Listo, guardar fotos"

#: app/text.py:436
#, python-brace-format
msgid ""
"📸 Photo {current}/{total} uploaded!\n"
"\n"
"You can add {remaining} more or tap '{finish_button}'"
msgstr ""
"📸 ¡Foto {current}/{total} subida!\n"
"\n"
"Puedes añadir {remaining} más o pulsar '{finish_button}'"

#: app/text.py:447
#, python-brace-format
msgid "✅ {} photos saved!"
msgstr "✅ ¡{} fotos guardadas!"

#: app/text.py:450
#, python-brace-format
msgid "✅ All {} photos uploaded!"
msgstr "✅ ¡Las {} fotos fueron subidas!"

#: app/text.py:454
msgid "⚠️ Maximum 3 photos! Tap 'Done, save photos' to finish."
msgstr "⚠️ ¡Máximo 3 fotos! Toca 'Listo, guardar fotos' para terminar."

#: app/text.py:458
msgid "📸 Send a photo or choose from the menu"
msgstr "📸 Envía una foto o elige una opción del menú"

#: app/text.py:462
msgid "❌ You need at least 1 photo to create your profile!"
msgstr "❌ ¡Necesitas al menos 1 foto para crear tu perfil!"

#: app/text.py:466
#, python-brace-format
msgid ""
"\n"
"🎂 <b>Set Your Age Range</b>\n"
"\n"
"Current range: <b>{min_age} - {max_age} years old</b>\n"
"\n"
"Enter the <b>minimum age</b> you want to see (18-99):\n"
"\n"
"Type a number or press ↩️ to cancel.\n"
msgstr ""
"\n"
"🎂 <b>Configura tu rango de edad</b>\n"
"\n"
"Rango actual: <b>{min_age} - {max_age} años</b>\n"
"\n"
"Introduce la <b>edad mínima</b> que deseas ver (18-99):\n"
"\n"
"Escribe un número o presiona ↩️ para cancelar.\n"

#: app/text.py:477
#, python-brace-format
msgid ""
"\n"
"🎂 <b>Set Your Age Range</b>\n"
"\n"
"Minimum age: <b>{min_age}</b> ✅\n"
"\n"
"Now enter the <b>maximum age</b> (18-99):\n"
"\n"
"Type a number or press ↩️ to cancel.\n"
msgstr ""
"\n"
"🎂 <b>Configura tu rango de edad</b>\n"
"\n"
"Edad mínima: <b>{min_age}</b> ✅\n"
"\n"
"Ahora introduce la <b>edad máxima</b> (18-99):\n"
"\n"
"Escribe un número o presiona ↩️ para cancelar.\n"

#: app/text.py:488
#, python-brace-format
msgid ""
"\n"
"✅ <b>Age filter set!</b>\n"
"\n"
"You'll now see profiles from <b>{min_age} to {max_age} years old</b>.\n"
"\n"
"Hit 🔍 to start browsing with your new filter!\n"
msgstr ""
"\n"
"✅ <b>¡Filtro de edad configurado!</b>\n"
"\n"
"Ahora verás perfiles de <b>{min_age} a {max_age} años</b>.\n"
"\n"
"¡Toca 🔍 para empezar a explorar con tu nuevo filtro!\n"

#: app/text.py:498
msgid ""
"\n"
"🔄 <b>Age filter reset!</b>\n"
"\n"
"Back to automatic age matching based on your age and compatibility.\n"
"\n"
"Hit 🔍 to start browsing!\n"
msgstr ""
"\n"
"🔄 <b>¡Filtro de edad restablecido!</b>\n"
"\n"
"Volviendo a la coincidencia automática según tu edad y compatibilidad.\n"
"\n"
"¡Toca 🔍 para empezar a explorar!\n"

#: app/text.py:508
msgid "❌ Age filter setup cancelled."
msgstr "❌ Configuración del filtro de edad cancelada."

#: app/text.py:512
msgid "⚠️ Age must be at least 18. Try again!"
msgstr "⚠️ ¡La edad debe ser de al menos 18 años! Inténtalo de nuevo."

#: app/text.py:516
msgid "⚠️ Age must be between 18 and 99. Try again!"
msgstr "⚠️ ¡La edad debe estar entre 18 y 99 años! Inténtalo de nuevo."

#: app/text.py:519
#, python-brace-format
msgid ""
"\n"
"⚠️ Max age must be ≥ min age (<b>{min_age}</b>).\n"
"\n"
"Enter a valid maximum age:\n"
msgstr ""
"\n"
"⚠️ La edad máxima debe ser ≥ edad mínima (<b>{min_age}</b>).\n"
"\n"
"Introduce una edad máxima válida:\n"

#: app/text.py:527
msgid "⚠️ Numbers only! Enter an age between 18-99."
msgstr "⚠️ ¡Solo números! Introduce una edad entre 18 y 99."

