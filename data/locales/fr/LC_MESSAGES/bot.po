#: app/text.py:361
msgid "✅ Language changed!"
msgstr "✅ Langue modifiée !"

#: app/text.py:365
msgid "Please select a valid option."
msgstr "Veuillez sélectionner une option valide."

#: app/text.py:369
msgid "Please select a mode first: /fun, /dates, or /friends"
msgstr "Choisis d'abord un mode : /fun, /dates ou /friends"

#: app/text.py:373
msgid "Error activating mode. Please try again."
msgstr "Erreur lors de l'activation du mode. Réessaie."

#: app/text.py:377
msgid "Unsupported language"
msgstr "Langue non supportée"

#: app/text.py:381
msgid "Create a profile before searching."
msgstr "Crée un profil avant de rechercher."

#: app/text.py:386
msgid ""
"\n"
"⚠️ <b>Report this profile:</b>\n"
"\n"
"Select a reason:\n"
"🔞 Inappropriate content\n"
"💰 Spam/Advertising\n"
"🔫 Other violation\n"
"\n"
"↩️ Cancel\n"
msgstr ""
"\n"
"⚠️ <b>Signaler ce profil :</b>\n"
"\n"
"Sélectionne une raison :\n"
"🔞 Contenu inapproprié\n"
"💰 Spam / Publicité\n"
"🔫 Autre infraction\n"
"\n"
"↩️ Annuler\n"

#: app/text.py:410
msgid ""
"✅ <b>Report submitted!</b>\n"
"\n"
"Thanks for keeping CONQUEER safe. We'll review this."
msgstr ""
"✅ <b>Signalement envoyé !</b>\n"
"\n"
"Merci de contribuer à la sécurité de CONQUEER. Nous allons examiner ce "
"profil."

#: app/text.py:415
msgid ""
"📸 <b>Upload new photos!</b>\n"
"\n"
"Send up to 3 photos to update your profile."
msgstr ""
"📸 <b>Envoie de nouvelles photos !</b>\n"
"\n"
"Envoie jusqu'à 3 photos pour mettre à jour ton profil."

#: app/text.py:419
msgid "📸 Photos unchanged"
msgstr "📸 Photos inchangées"

#: app/text.py:423
msgid "⚠️ No photos uploaded. Try again!"
msgstr "⚠️ Aucune photo envoyée. Réessaie !"

#: app/text.py:427
msgid "❌ Error saving photos. Please try again."
msgstr "❌ Erreur lors de l'enregistrement des photos. Réessaie."

#: app/text.py:431 app/text.py:441
msgid "✅ Done, save photos"
msgstr "✅ Terminé, enregistrer les photos"

#: app/text.py:436
#, python-brace-format
msgid ""
"📸 Photo {current}/{total} uploaded!\n"
"\n"
"You can add {remaining} more or tap '{finish_button}'"
msgstr ""
"📸 Photo {current}/{total} envoyée !\n"
"\n"
"Tu peux en ajouter {remaining} de plus ou appuyer sur '{finish_button}'"

#: app/text.py:447
#, python-brace-format
msgid "✅ {} photos saved!"
msgstr "✅ {} photos enregistrées !"

#: app/text.py:450
#, python-brace-format
msgid "✅ All {} photos uploaded!"
msgstr "✅ Les {} photos ont été envoyées !"

#: app/text.py:454
msgid "⚠️ Maximum 3 photos! Tap 'Done, save photos' to finish."
msgstr ""
"⚠️ 3 photos maximum ! Appuie sur 'Terminé, enregistrer les photos' pour "
"finir."

#: app/text.py:458
msgid "📸 Send a photo or choose from the menu"
msgstr "📸 Envoie une photo ou choisis dans le menu"

#: app/text.py:462
msgid "❌ You need at least 1 photo to create your profile!"
msgstr "❌ Il te faut au moins 1 photo pour créer ton profil !"

#: app/text.py:466
#, python-brace-format
msgid ""
"\n"
"🎂 <b>Set Your Age Range</b>\n"
"\n"
"Current range: <b>{min_age} - {max_age} years old</b>\n"
"\n"
"Enter the <b>minimum age</b> you want to see (18-99):\n"
"\n"
"Type a number or press ↩️ to cancel.\n"
msgstr ""
"\n"
"🎂 <b>Définis ta tranche d'âge</b>\n"
"\n"
"Tranche actuelle : <b>{min_age} - {max_age} ans</b>\n"
"\n"
"Entre l'<b>âge minimum</b> souhaité (18-99) :\n"
"\n"
"Tape un nombre ou appuie sur ↩️ pour annuler.\n"

#: app/text.py:477
#, python-brace-format
msgid ""
"\n"
"🎂 <b>Set Your Age Range</b>\n"
"\n"
"Minimum age: <b>{min_age}</b> ✅\n"
"\n"
"Now enter the <b>maximum age</b> (18-99):\n"
"\n"
"Type a number or press ↩️ to cancel.\n"
msgstr ""
"\n"
"🎂 <b>Définis ta tranche d'âge</b>\n"
"\n"
"Âge minimum : <b>{min_age}</b> ✅\n"
"\n"
"Entre maintenant l'<b>âge maximum</b> (18-99) :\n"
"\n"
"Tape un nombre ou appuie sur ↩️ pour annuler.\n"

#: app/text.py:488
#, python-brace-format
msgid ""
"\n"
"✅ <b>Age filter set!</b>\n"
"\n"
"You'll now see profiles from <b>{min_age} to {max_age} years old</b>.\n"
"\n"
"Hit 🔍 to start browsing with your new filter!\n"
msgstr ""
"\n"
"✅ <b>Filtre d'âge configuré !</b>\n"
"\n"
"Tu verras désormais les profils de <b>{min_age} à {max_age} ans</b>.\n"
"\n"
"Appuie sur 🔍 pour explorer avec ce nouveau filtre !\n"

#: app/text.py:498
msgid ""
"\n"
"🔄 <b>Age filter reset!</b>\n"
"\n"
"Back to automatic age matching based on your age and compatibility.\n"
"\n"
"Hit 🔍 to start browsing!\n"
msgstr ""
"\n"
"🔄 <b>Filtre d'âge réinitialisé !</b>\n"
"\n"
"Retour au matching automatique basé sur ton âge et tes préférences.\n"
"\n"
"Appuie sur 🔍 pour explorer !\n"

#: app/text.py:508
msgid "❌ Age filter setup cancelled."
msgstr "❌ Configuration du filtre d'âge annulée."

#: app/text.py:512
msgid "⚠️ Age must be at least 18. Try again!"
msgstr "⚠️ L'âge doit être d'au moins 18 ans ! Réessaie."

#: app/text.py:516
msgid "⚠️ Age must be between 18 and 99. Try again!"
msgstr "⚠️ L'âge doit être compris entre 18 et 99 ans ! Réessaie."

#: app/text.py:519
#, python-brace-format
msgid ""
"\n"
"⚠️ Max age must be ≥ min age (<b>{min_age}</b>).\n"
"\n"
"Enter a valid maximum age:\n"
msgstr ""
"\n"
"⚠️ L'âge maximum doit être ≥ âge minimum (<b>{min_age}</b>).\n"
"\n"
"Entre un âge maximum valide :\n"

#: app/text.py:527
msgid "⚠️ Numbers only! Enter an age between 18-99."
msgstr "⚠️ Chiffres uniquement ! Entre un âge entre 18 et 99."

