msgstr "❌ Message annulé. On passe à la suite !"

#: app/text.py:327
msgid "⚠️ Invalid choice. Use the keyboard or type correctly! 📝"
msgstr "⚠️ Choix invalide. Utilise le clavier ou écris correctement ! 📝"

#: app/text.py:331
msgid "⚠️ Too long! Shorten your message. ✂️"
msgstr "⚠️ Trop long ! Raccourcis ton message. ✂️"

#: app/text.py:335
msgid "🌍 City not found. Try again with a different spelling!"
msgstr "🌍 Ville non trouvée. Réessaie avec une autre orthographe !"

#: app/text.py:339
msgid "⚠️ Invalid photo format! Please upload a proper image. 🖼️"
msgstr "⚠️ Format de photo invalide ! Envoie une image valide. 🖼️"

#: app/text.py:343
msgid "⚠️ Age must be a number! 🔢"
msgstr "⚠️ L'âge doit être un nombre ! 🔢"

#: app/text.py:348
#, python-brace-format
msgid ""
"📢 <b>Spread the word!</b>\n"
"\n"
"Invited users: <b>{}</b>\n"
"\n"
"Your invite link:\n"
