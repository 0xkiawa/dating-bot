msgstr "✅ Все {} фото загружены!"

#: app/text.py:454
msgid "⚠️ Maximum 3 photos! Tap 'Done, save photos' to finish."
msgstr "⚠️ Максимум 3 фото! Нажми 'Готово, сохранить фото' для завершения."

