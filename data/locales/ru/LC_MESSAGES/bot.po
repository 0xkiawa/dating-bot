#: app/text.py:166
msgid "casual hookups and fun"
msgstr "горячие встречи и развлечения"

#: app/text.py:167
msgid "romantic connections"
msgstr "романтические отношения"

#: app/text.py:168
msgid "platonic friendships"
msgstr "дружеские отношения"

#: app/text.py:171
#, python-brace-format
msgid ""
"\n"
"{new_icon} <b>Switch to {new_name} Mode?</b>\n"
"\n"
"You're currently in <b>{current_name} mode</b>. Switching to "
"<b>{new_name} mode</b> will show you guys looking for "
"<b>{new_description}</b> instead.\n"
"\n"
"Ready to make the switch?\n"
msgstr ""
"\n"
"{new_icon} <b>Переключиться в режим {new_name}?</b>\n"
"\n"
"Сейчас у тебя включён <b>режим {current_name}</b>. Переключение в "
"<b>режим {new_name}</b> покажет парней, которые ищут "
"<b>{new_description}</b>.\n"
"\n"
"Готов переключиться?\n"

#: app/text.py:186
msgid "Staying put! Back to your current mode. 👍"
msgstr "Остаёмся на месте! Возвращаемся в текущий режим. 👍"

#: app/text.py:191
msgid ""
"What's your position? 🔥\n"
"\n"
"Top, Bottom, or Verse?"
msgstr ""
"Какая у тебя позиция? 🔥\n"
"\n"
"Топ, Боттом или Универсал?"

#: app/text.py:195
msgid ""
"Who are you looking for? 💕\n"
"\n"
"Top, Bottom, Verse, or All?"
msgstr ""
"Кого ты ищешь? 💕\n"
"\n"
"Топы, Боттомы, Универсалы или Все?"

#: app/text.py:199
msgid ""
"Show yourself! 📸\n"
"\n"
"Upload up to 3 photos (make it count!)"
msgstr ""
"Покажи себя! 📸\n"
"\n"
"Загрузи до 3 фото (выбери лучшие!)"

#: app/text.py:203
msgid "What should we call you? ✍️"
msgstr "Как тебя зовут? ✍️"

#: app/text.py:207
msgid "How old are you, king? 🎂"
msgstr "Сколько тебе лет, король? 🎂"

#: app/text.py:211
msgid "What city do you reign in? 🏙️"
msgstr "В каком городе ты правишь? 🏙️"

#: app/text.py:215
msgid ""
"Tell us about yourself! 📝\n"
"\n"
"What makes you... you? (This is your chance to shine!)"
msgstr ""
"Расскажи о себе! 📝\n"
"\n"
"Что делает тебя особенным? (Твой шанс выделиться!)"

#: app/text.py:220
msgid ""
"Can you host? 🏠\n"
"\n"
"(Important for Fun mode!)"
msgstr ""
"Можешь принять у себя? 🏠\n"
"\n"
"(Важно для режима Fun!)"

#: app/text.py:225
msgid ""
"\n"
"<b>Hosting Preference?</b> 🏠\n"
"\n"
"Who do you want to see?\n"
msgstr ""
"\n"
"<b>Где встретиться?</b> 🏠\n"
"\n"
"Кого ты хочешь видеть?\n"

#: app/text.py:234
msgid ""
"\n"
"<b>Who do you want to see?</b> 🔍\n"
"\n"
"Select the role preference for your search:\n"
msgstr ""
"\n"
"<b>Кого ты хочешь видеть?</b> 🔍\n"
"\n"
"Выбери позицию для поиска:\n"

#: app/text.py:242
msgid ""
"👑 <b>Profile created!</b>\n"
"\n"
"You're all set! Time to start conquering. Hit 🎭 to choose your mode!"
msgstr ""
"👑 <b>Анкета создана!</b>\n"
"\n"
"Всё готово! Время побеждать. Нажми 🎭 чтобы выбрать режим!"

#: app/text.py:246
msgid ""
"\n"
"❌ <b>Profile disabled</b>\n"
"\n"
"Your profile is now hidden and some features are unavailable.\n"
"\n"
"Want to come back? Just send /start to reactivate!\n"
msgstr ""
"\n"
"❌ <b>Анкета отключена</b>\n"
"\n"
"Твой профиль скрыт, некоторые функции недоступны.\n"
"\n"
"Хочешь вернуться? Просто отправь /start!\n"

#: app/text.py:256
msgid ""
"✅ <b>Welcome back, king!</b>\n"
"\n"
"Your profile is active again. Let's conquer! 👑"
msgstr ""
"✅ <b>С возвращением, король!</b>\n"
"\n"
"Твой профиль снова активен. Вперёд! 👑"

#: app/text.py:260
msgid "🔍 <b>Searching for matches...</b>"
msgstr "🔍 <b>Ищем подходящие анкеты...</b>"

#: app/text.py:264
#, python-brace-format
msgid ""
"📬 <b>{} guys liked your profile!</b>\n"
"\n"
"Let's see who they are:"
msgstr ""
