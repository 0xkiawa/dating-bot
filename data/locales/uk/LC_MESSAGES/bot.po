#: app/text.py:361
msgid "✅ Language changed!"
msgstr "✅ Мову змінено!"

#: app/text.py:365
msgid "Please select a valid option."
msgstr "Будь ласка, обери варіант із запропонованих."

#: app/text.py:369
msgid "Please select a mode first: /fun, /dates, or /friends"
msgstr "Спочатку обери режим: /fun, /dates або /friends"

#: app/text.py:373
msgid "Error activating mode. Please try again."
msgstr "Помилка при активації режиму. Спробуй ще раз."

#: app/text.py:377
msgid "Unsupported language"
msgstr "Мова не підтримується"

#: app/text.py:381
msgid "Create a profile before searching."
msgstr "Створи анкету перед пошуком."

#: app/text.py:386
msgid ""
"\n"
"⚠️ <b>Report this profile:</b>\n"
"\n"
"Select a reason:\n"
"🔞 Inappropriate content\n"
"💰 Spam/Advertising\n"
"🔫 Other violation\n"
"\n"
"↩️ Cancel\n"
msgstr ""
"\n"
"⚠️ <b>Поскаржитися на анкету:</b>\n"
"\n"
"Обери причину:\n"
"🔞 Неприйнятний контент\n"
"💰 Спам / Реклама\n"
"🔫 Інше порушення\n"
"\n"
"↩️ Скасувати\n"

#: app/text.py:410
msgid ""
"✅ <b>Report submitted!</b>\n"
"\n"
"Thanks for keeping CONQUEER safe. We'll review this."
msgstr ""
"✅ <b>Скаргу надіслано!</b>\n"
"\n"
"Дякуємо за допомогу в безпеці CONQUEER. Ми перевіримо анкету."

#: app/text.py:415
msgid ""
"📸 <b>Upload new photos!</b>\n"
"\n"
"Send up to 3 photos to update your profile."
msgstr ""
"📸 <b>Завантаж нові фото!</b>\n"
"\n"
"Надішли до 3 фото, щоб оновити анкету."

#: app/text.py:419
msgid "📸 Photos unchanged"
msgstr "📸 Фотографії залишилися без змін"

#: app/text.py:423
msgid "⚠️ No photos uploaded. Try again!"
msgstr "⚠️ Фото не завантажено. Спробуй знову!"

#: app/text.py:427
msgid "❌ Error saving photos. Please try again."
msgstr "❌ Помилка збереження фото. Спробуй знову."

#: app/text.py:431 app/text.py:441
msgid "✅ Done, save photos"
msgstr "✅ Готово, зберегти фото"

#: app/text.py:436
#, python-brace-format
msgid ""
"📸 Photo {current}/{total} uploaded!\n"
"\n"
"You can add {remaining} more or tap '{finish_button}'"
msgstr ""
"📸 Фото {current}/{total} завантажено!\n"
"\n"
"Можна додати ще {remaining} або натиснути '{finish_button}'"

#: app/text.py:447
#, python-brace-format
msgid "✅ {} photos saved!"
msgstr "✅ Збережено {} фото!"

#: app/text.py:450
#, python-brace-format
msgid "✅ All {} photos uploaded!"
msgstr "✅ Всі {} фото завантажено!"

#: app/text.py:454
msgid "⚠️ Maximum 3 photos! Tap 'Done, save photos' to finish."
msgstr "⚠️ Максимум 3 фото! Натисни 'Готово, зберегти фото' для завершення."

#: app/text.py:458
msgid "📸 Send a photo or choose from the menu"
msgstr "📸 Надішли фото або обери дію в меню"

#: app/text.py:462
msgid "❌ You need at least 1 photo to create your profile!"
msgstr "❌ Для створення анкети потрібне хоча б одне фото!"

#: app/text.py:466
#, python-brace-format
msgid ""
"\n"
"🎂 <b>Set Your Age Range</b>\n"
"\n"
"Current range: <b>{min_age} - {max_age} years old</b>\n"
"\n"
"Enter the <b>minimum age</b> you want to see (18-99):\n"
"\n"
"Type a number or press ↩️ to cancel.\n"
msgstr ""
"\n"
"🎂 <b>Налаштування віку</b>\n"
"\n"
"Поточний діапазон: <b>{min_age} - {max_age} років</b>\n"
"\n"
"Введи <b>мінімальний вік</b> (18-99):\n"
"\n"
"Напиши число або натисни ↩️ для скасування.\n"

#: app/text.py:477
#, python-brace-format
msgid ""
"\n"
"🎂 <b>Set Your Age Range</b>\n"
"\n"
"Minimum age: <b>{min_age}</b> ✅\n"
"\n"
"Now enter the <b>maximum age</b> (18-99):\n"
"\n"
"Type a number or press ↩️ to cancel.\n"
msgstr ""
"\n"
"🎂 <b>Налаштування віку</b>\n"
"\n"
"Мінімальний вік: <b>{min_age}</b> ✅\n"
"\n"
"Тепер введи <b>максимальний вік</b> (18-99):\n"
"\n"
"Напиши число або натисни ↩️ для скасування.\n"

#: app/text.py:488
#, python-brace-format
msgid ""
"\n"
"✅ <b>Age filter set!</b>\n"
"\n"
"You'll now see profiles from <b>{min_age} to {max_age} years old</b>.\n"
"\n"
"Hit 🔍 to start browsing with your new filter!\n"
msgstr ""
"\n"
"✅ <b>Фільтр віку встановлено!</b>\n"
"\n"
"Тепер ти бачитимеш анкети від <b>{min_age} до {max_age} років</b>.\n"
"\n"
"Натисни 🔍 щоб почати пошук з новим фільтром!\n"

#: app/text.py:498
msgid ""
"\n"
"🔄 <b>Age filter reset!</b>\n"
"\n"
"Back to automatic age matching based on your age and compatibility.\n"
"\n"
"Hit 🔍 to start browsing!\n"
msgstr ""
"\n"
"🔄 <b>Фільтр віку скинуто!</b>\n"
"\n"
"Повернення до автоматичного підбору за віком та сумісністю.\n"
"\n"
"Натисни 🔍 для пошуку!\n"

#: app/text.py:508
msgid "❌ Age filter setup cancelled."
msgstr "❌ Налаштування фільтра віку скасовано."

#: app/text.py:512
msgid "⚠️ Age must be at least 18. Try again!"
msgstr "⚠️ Вік повинен бути не менше 18 років! Спробуй знову."

#: app/text.py:516
msgid "⚠️ Age must be between 18 and 99. Try again!"
msgstr "⚠️ Вік повинен бути від 18 до 99 років! Спробуй знову."

#: app/text.py:519
#, python-brace-format
msgid ""
"\n"
"⚠️ Max age must be ≥ min age (<b>{min_age}</b>).\n"
"\n"
"Enter a valid maximum age:\n"
msgstr ""
"\n"
"⚠️ Максимальний вік повинен бути ≥ мінімального (<b>{min_age}</b>).\n"
"\n"
"Введи коректний максимальний вік:\n"

#: app/text.py:527
msgid "⚠️ Numbers only! Enter an age between 18-99."
msgstr "⚠️ Тільки числа! Введи вік від 18 до 99."

