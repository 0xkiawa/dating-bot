#, python-brace-format
msgid ""
"💌 <b>Message for you:</b>\n"
"\n"
"{}"
msgstr ""
"💌 <b>Сообщение для тебя:</b>\n"
"\n"
"{}"

#: app/text.py:309
msgid ""
"✉️ <b>Send a message</b> (up to 250 characters)\n"
"\n"
"Make it count! Or skip with the button below."
msgstr ""
"✉️ <b>Отправь сообщение</b> (до 250 символов)\n"
"\n"
"Сделай его ярким! Или пропусти кнопкой ниже."

#: app/text.py:314
msgid "✅ Message sent! Now we wait... 🤞"
msgstr "✅ Сообщение отправлено! Теперь ждём ответа... 🤞"

#: app/text.py:318
msgid "⚠️ Message too long! Keep it under 250 characters."
msgstr "⚠️ Сообщение слишком длинное! Не более 250 символов."

#: app/text.py:322
msgid "❌ Message cancelled. Moving on!"
msgstr "❌ Сообщение отменено. Идём дальше!"

#: app/text.py:327
msgid "⚠️ Invalid choice. Use the keyboard or type correctly! 📝"
msgstr "⚠️ Неверный выбор. Используй клавиатуру или напиши правильно! 📝"

#: app/text.py:331
msgid "⚠️ Too long! Shorten your message. ✂️"
msgstr "⚠️ Слишком длинно! Сократи сообщение. ✂️"

#: app/text.py:335
msgid "🌍 City not found. Try again with a different spelling!"
msgstr "🌍 Город не найден. Попробуй написать иначе!"

#: app/text.py:339
msgid "⚠️ Invalid photo format! Please upload a proper image. 🖼️"
msgstr "⚠️ Неверный формат! Пожалуйста, загрузи изображение. 🖼️"

#: app/text.py:343
msgid "⚠️ Age must be a number! 🔢"
msgstr "⚠️ Возраст должен быть числом! 🔢"

#: app/text.py:348
#, python-brace-format
msgid ""
