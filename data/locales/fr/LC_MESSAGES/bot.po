#: app/text.py:171
#, python-brace-format
msgid ""
"\n"
"{new_icon} <b>Switch to {new_name} Mode?</b>\n"
"\n"
"You're currently in <b>{current_name} mode</b>. Switching to "
"<b>{new_name} mode</b> will show you guys looking for "
"<b>{new_description}</b> instead.\n"
"\n"
"Ready to make the switch?\n"
msgstr ""
"\n"
"{new_icon} <b>Passer en mode {new_name} ?</b>\n"
"\n"
"Tu es actuellement en <b>mode {current_name}</b>. Passer en <b>mode "
"{new_name}</b> te montrera des mecs qui cherchent "
"<b>{new_description}</b>.\n"
"\n"
"Prêt à changer ?\n"

#: app/text.py:186
msgid "Staying put! Back to your current mode. 👍"
msgstr "On reste là ! Retour à ton mode actuel. 👍"

#: app/text.py:191
msgid ""
"What's your position? 🔥\n"
"\n"
"Top, Bottom, or Verse?"
msgstr ""
"Quelle est ta position ? 🔥\n"
"\n"
"Top, Bottom ou Versatile ?"

#: app/text.py:195
msgid ""
"Who are you looking for? 💕\n"
"\n"
"Top, Bottom, Verse, or All?"
msgstr ""
"Qui recherches-tu ? 💕\n"
"\n"
"Tops, Bottoms, Versatiles ou Tous ?"

#: app/text.py:199
msgid ""
"Show yourself! 📸\n"
"\n"
"Upload up to 3 photos (make it count!)"
msgstr ""
"Montre-toi ! 📸\n"
"\n"
"Envoie jusqu'à 3 photos (choisis les meilleures !)"

#: app/text.py:203
msgid "What should we call you? ✍️"
msgstr "Comment doit-on t'appeler ? ✍️"

#: app/text.py:207
msgid "How old are you, king? 🎂"
msgstr "Quel âge as-tu, roi ? 🎂"

#: app/text.py:211
msgid "What city do you reign in? 🏙️"
msgstr "Dans quelle ville règnes-tu ? 🏙️"

#: app/text.py:215
msgid ""
"Tell us about yourself! 📝\n"
"\n"
"What makes you... you? (This is your chance to shine!)"
msgstr ""
"Parle-nous de toi ! 📝\n"
"\n"
"Qu'est-ce qui te rend unique ? (C'est ton moment de briller !)"

#: app/text.py:220
msgid ""
"Can you host? 🏠\n"
"\n"
"(Important for Fun mode!)"
msgstr ""
"Peux-tu recevoir ? 🏠\n"
"\n"
"(Important pour le mode Fun !)"

#: app/text.py:225
msgid ""
"\n"
"<b>Hosting Preference?</b> 🏠\n"
"\n"
"Who do you want to see?\n"
msgstr ""
"\n"
"<b>Préférence de logement ?</b> 🏠\n"
"\n"
"Qui veux-tu voir ?\n"

#: app/text.py:234
msgid ""
"\n"
"<b>Who do you want to see?</b> 🔍\n"
"\n"
"Select the role preference for your search:\n"
msgstr ""
"\n"
"<b>Qui veux-tu voir ?</b> 🔍\n"
"\n"
"Sélectionne la position souhaitée pour ta recherche :\n"

#: app/text.py:242
msgid ""
"👑 <b>Profile created!</b>\n"
"\n"
"You're all set! Time to start conquering. Hit 🎭 to choose your mode!"
msgstr ""
"👑 <b>Profil créé !</b>\n"
"\n"
"Tout est prêt ! C'est le moment de conquérir. Appuie sur 🎭 pour choisir "
"ton mode !"

#: app/text.py:246
msgid ""
"\n"
"❌ <b>Profile disabled</b>\n"
"\n"
"Your profile is now hidden and some features are unavailable.\n"
"\n"
"Want to come back? Just send /start to reactivate!\n"
msgstr ""
"\n"
"❌ <b>Profil désactivé</b>\n"
"\n"
"Ton profil est désormais masqué et certaines fonctionnalités sont "
"indisponibles.\n"
"\n"
"Tu veux revenir ? Envoie simplement /start pour le réactiver !\n"

#: app/text.py:256
msgid ""
"✅ <b>Welcome back, king!</b>\n"
"\n"
"Your profile is active again. Let's conquer! 👑"
msgstr ""
"✅ <b>Bon retour parmi nous, roi !</b>\n"
"\n"
"Ton profil est de nouveau actif. C'est reparti ! 👑"

#: app/text.py:260
msgid "🔍 <b>Searching for matches...</b>"
msgstr "🔍 <b>Recherche de profils en cours...</b>"

#: app/text.py:264
#, python-brace-format
msgid ""
"📬 <b>{} guys liked your profile!</b>\n"
"\n"
"Let's see who they are:"
msgstr ""
"📬 <b>{} mecs ont aimé ton profil !</b>\n"
"\n"
"Voyons qui ils sont :"

#: app/text.py:269
msgid ""
"No matches found in this mode. Try adjusting your filters or check back "
