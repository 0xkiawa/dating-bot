"\n"
"{}"

#: app/text.py:309
msgid ""
"✉️ <b>Send a message</b> (up to 250 characters)\n"
"\n"
"Make it count! Or skip with the button below."
msgstr ""
"✉️ <b>Envoie un message</b> (jusqu'à 250 caractères)\n"
"\n"
"Fais bonne impression ! Ou passe avec le bouton ci-dessous."

#: app/text.py:314
msgid "✅ Message sent! Now we wait... 🤞"
msgstr "✅ Message envoyé ! Maintenant, on attend... 🤞"

#: app/text.py:318
msgid "⚠️ Message too long! Keep it under 250 characters."
msgstr "⚠️ Message trop long ! Moins de 250 caractères s'il te plaît."

#: app/text.py:322
