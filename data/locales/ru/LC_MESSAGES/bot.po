msgstr ""
"В этом режиме никого не нашлось. Попробуй изменить фильтры или загляни "
"позже! 🌍"

#: app/text.py:273
msgid ""
"🍆 <b>No more profiles in Fun mode!</b>\n"
"\n"
"Try changing your age/hosting filters or check back later for fresh meat!"
" 🔥"
msgstr ""
