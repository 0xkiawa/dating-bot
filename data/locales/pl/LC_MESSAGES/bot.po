#: app/text.py:381
msgid "Create a profile before searching."
msgstr "Utwórz profil przed rozpoczęciem wyszukiwania."

#: app/text.py:386
msgid ""
"\n"
"⚠️ <b>Report this profile:</b>\n"
"\n"
"Select a reason:\n"
"🔞 Inappropriate content\n"
"💰 Spam/Advertising\n"
"🔫 Other violation\n"
"\n"
"↩️ Cancel\n"
msgstr ""
"\n"
