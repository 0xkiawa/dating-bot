#: app/text.py:171
#, python-brace-format
msgid ""
"\n"
"{new_icon} <b>Switch to {new_name} Mode?</b>\n"
"\n"
"You're currently in <b>{current_name} mode</b>. Switching to "
"<b>{new_name} mode</b> will show you guys looking for "
"<b>{new_description}</b> instead.\n"
"\n"
"Ready to make the switch?\n"
msgstr ""
"\n"
"{new_icon} <b>¿Cambiar al modo {new_name}?</b>\n"
"\n"
"Actualmente estás en el <b>modo {current_name}</b>. Cambiar al <b>modo "
"{new_name}</b> te mostrará chicos que buscan <b>{new_description}</b>.\n"
"\n"
"¿Listo para hacer el cambio?\n"

#: app/text.py:186
msgid "Staying put! Back to your current mode. 👍"
msgstr "¡Nos quedamos aquí! De vuelta a tu modo actual. 👍"

#: app/text.py:191
msgid ""
"What's your position? 🔥\n"
"\n"
"Top, Bottom, or Verse?"
msgstr ""
"¿Cuál es tu rol? 🔥\n"
"\n"
"¿Activo, Pasivo o Versátil?"

#: app/text.py:195
msgid ""
"Who are you looking for? 💕\n"
"\n"
"Top, Bottom, Verse, or All?"
msgstr ""
"¿A quién buscas? 💕\n"
"\n"
"¿Activos, Pasivos, Versátiles o Todos?"

#: app/text.py:199
msgid ""
"Show yourself! 📸\n"
"\n"
"Upload up to 3 photos (make it count!)"
msgstr ""
"¡Muéstrate! 📸\n"
"\n"
"Sube hasta 3 fotos (¡haz que valgan la pena!)"

#: app/text.py:203
msgid "What should we call you? ✍️"
msgstr "¿Cómo quieres que te llamemos? ✍️"

#: app/text.py:207
msgid "How old are you, king? 🎂"
msgstr "¿Cuántos años tienes, rey? 🎂"

#: app/text.py:211
msgid "What city do you reign in? 🏙️"
msgstr "¿En qué ciudad vives? 🏙️"

#: app/text.py:215
msgid ""
"Tell us about yourself! 📝\n"
"\n"
"What makes you... you? (This is your chance to shine!)"
msgstr ""
"¡Cuéntanos sobre ti! 📝\n"
"\n"
"¿Qué te hace único? (¡Es tu momento de brillar!)"

#: app/text.py:220
msgid ""
"Can you host? 🏠\n"
"\n"
"(Important for Fun mode!)"
msgstr ""
"¿Puedes hospedar / tienes lugar? 🏠\n"
"\n"
"(¡Importante para el modo Fun!)"

#: app/text.py:225
msgid ""
"\n"
"<b>Hosting Preference?</b> 🏠\n"
"\n"
"Who do you want to see?\n"
msgstr ""
"\n"
"<b>¿Preferencia de lugar?</b> 🏠\n"
"\n"
"¿A quiénes quieres ver?\n"

#: app/text.py:234
msgid ""
"\n"
"<b>Who do you want to see?</b> 🔍\n"
"\n"
"Select the role preference for your search:\n"
msgstr ""
"\n"
"<b>¿A quién quieres ver?</b> 🔍\n"
"\n"
